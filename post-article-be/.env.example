# article-service (owns MySQL `article` DB, served internally on 8081;
# exposed publicly through api-gateway on 8080)
APP_PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=article

# api-gateway (public edge -> ARTICLE_SERVICE_URL)
GATEWAY_PORT=8080
ARTICLE_SERVICE_URL=http://localhost:8081
